    tu_cs_emit(cs, A6XX_CP_SET_MARKER_0_RT_WA_END);
 }
 
+/* Swap2 diagnostics: wait-for-idles emitted by barriers, outside ([0]) and inside ([1]) render passes, logged every 3000 submissions
+ * (swap2_wfi_submit, tu_queue); debug.mesa.tu.rp.nowfi=1 drops the ones inside render passes (an incorrect picture is possible: a bound on what they cost) */
+#include <atomic>
+#include "util/os_misc.h"
+static std::atomic<uint64_t> swap2_wfi[2];
+static void swap2_wfi_count(int in_pass) { swap2_wfi[in_pass].fetch_add(1, std::memory_order_relaxed); }
+static int swap2_rp_nowfi(void)
+{
+   static int v = -1, n;
+   if (v < 0 || !(++n & 1023)) { const char *o = os_get_option("TU_RP_NOWFI"); v = o && o[0] == '1'; }
+   return v;
+}
+void swap2_wfi_submit(void);
+void swap2_wfi_submit(void)
+{
+   static std::atomic<uint64_t> subs; static uint64_t last[2];
+   if ((subs.fetch_add(1, std::memory_order_relaxed) + 1) % 3000) return;
+   uint64_t a = swap2_wfi[0].load(), b = swap2_wfi[1].load();
+   mesa_logi("swap2: wait-for-idles from barriers in the last 3000 submissions: %llu outside render passes, %llu inside (nowfi %d)",
+             (unsigned long long)(a - last[0]), (unsigned long long)(b - last[1]), swap2_rp_nowfi());
+   last[0] = a; last[1] = b;
+}
