+   /* Swap2 diagnostic (TU_SSBO_RESTRICT=1, Android property debug.mesa.tu.ssbo.restrict): every storage buffer variable taken as Restrict, so one
+    * the shader never writes is inferred read-only (nir_opt_access) and its loads may go through isam, the texture path, instead of ldib. Not
+    * conformant in general (a buffer written through another binding of the same shader would be read stale): it measures what NonWritable /
+    * Restrict decorations in the module would give */
+   {
+      static int restrict_ssbo = -1;
+      if (restrict_ssbo < 0) { const char *o = os_get_option("TU_SSBO_RESTRICT"); restrict_ssbo = o && o[0] == '1'; }
+      if (restrict_ssbo)
+         nir_foreach_variable_with_modes(var, nir, nir_var_mem_ssbo)
+            var->data.access |= ACCESS_RESTRICT;
+      /* TU_SSBO_RO=<name>,<name>...: those storage buffer variables taken as NonWritable, as if the module said so (offline experiments) */
+      const char *ro = os_get_option("TU_SSBO_RO");
+      if (ro && *ro)
+         nir_foreach_variable_with_modes(var, nir, nir_var_mem_ssbo) {
+            if (!var->name) continue;
+            size_t n = strlen(var->name);
+            for (const char *p = ro; (p = strstr(p, var->name)); p += n)
+               if ((p == ro || p[-1] == ',') && (p[n] == ',' || !p[n])) { var->data.access |= ACCESS_NON_WRITEABLE; break; }
+         }
+   }
+   swap2_ssbo_ro_auto(nir);
    NIR_PASS(_, nir, nir_opt_access, &access_options);
 
