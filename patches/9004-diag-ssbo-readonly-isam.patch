+/* Swap2 diagnostic (TU_SSBO_RO_AUTO=1, Android property debug.mesa.tu.ssbo.ro.auto): a storage buffer variable that no store or atomic of the
+ * shader reaches is taken as NonWritable, as a module could declare it, so its loads may use isam (the texture path) instead of ldib. Only when
+ * every storage buffer write of the shader names its variable. Not conformant: another binding (or a buffer device address) over the same
+ * memory may be written by the shader; it measures what the decorations would give */
+static void
+swap2_ssbo_ro_auto(nir_shader *nir)
+{
+   static int on = -1;
+   if (on < 0) { const char *o = os_get_option("TU_SSBO_RO_AUTO"); on = o && o[0] == '1'; }
+   if (!on)
+      return;
+   struct set *written = _mesa_pointer_set_create(NULL);
+   bool unknown = false;
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            int src = -1;
+            switch (in->intrinsic) {
+            case nir_intrinsic_store_ssbo: src = 1; break;
+            case nir_intrinsic_ssbo_atomic:
+            case nir_intrinsic_ssbo_atomic_swap: src = 0; break;
+            default: break;
+            }
+            if (src < 0)
+               continue;
+            const nir_variable *var = nir_get_binding_variable(nir, nir_chase_binding(in->src[src]));
+            if (var) _mesa_set_add(written, var); else unknown = true;
+         }
+      }
+   }
+   if (!unknown)
+      nir_foreach_variable_with_modes(var, nir, nir_var_mem_ssbo)
+         if (!_mesa_set_search(written, var))
+            var->data.access |= ACCESS_NON_WRITEABLE;
+   _mesa_set_destroy(written, NULL);
+}
