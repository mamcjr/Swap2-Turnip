+/* The next-use distances at a block's start and end are kept only for the
+ * values live there (the liveness sets): every other value's distance is
+ * UINT_MAX by construction. Dense per-block arrays over every SSA definition
+ * cost blocks * definitions * 8 bytes, which for a large shader with many
+ * blocks is gigabytes (12,707 blocks and 37,700 definitions: 3.6 GiB), and on
+ * Android each array is a separate mapping of the allocator, enough to exhaust
+ * vm.max_map_count.
+ */
+static int
+cmp_name(const void *a, const void *b)
+{
+   unsigned x = *(const unsigned *)a, y = *(const unsigned *)b;
+   return x < y ? -1 : x > y;
+}
+
+static unsigned *
+next_use_ref(const struct ra_spill_next_use *nu, unsigned name)
+{
+   const unsigned *p = bsearch(&name, nu->names, nu->count, sizeof(unsigned),
+                               cmp_name);
+   return p ? &nu->dist[p - nu->names] : NULL;
+}
+
+static void
+next_use_init(struct ra_spill_ctx *ctx, struct ra_spill_next_use *nu,
+              const BITSET_WORD *set)
+{
+   unsigned n = 0, k = 0, name;
+   BITSET_FOREACH_SET (name, set, ctx->live->definitions_count)
+      n++;
+   nu->count = n;
+   nu->names = ralloc_array(ctx, unsigned, n);
+   nu->dist = ralloc_array(ctx, unsigned, n);
+   BITSET_FOREACH_SET (name, set, ctx->live->definitions_count) {
+      nu->names[k] = name;
+      nu->dist[k] = UINT_MAX;
+      k++;
+   }
+}
